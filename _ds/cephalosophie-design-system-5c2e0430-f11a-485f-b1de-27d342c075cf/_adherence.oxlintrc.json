{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/game/**",
              "ui_kits/brain_editor/**",
              "ui_kits/game_table/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Space Grotesk|JetBrains Mono|Space Mono))/i]",
        "message": "Font not provided by the design system. Available: Space Grotesk, JetBrains Mono, Space Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|appearance|size|className|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, variant, appearance, size, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:gold|blue|red|orange|green|pink|muted)$/]",
        "message": "<Badge> variant must be one of 'gold' | 'blue' | 'red' | 'orange' | 'green' | 'pink' | 'muted'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='appearance'] > Literal[value!=/^(?:filled|outline)$/]",
        "message": "<Badge> appearance must be one of 'filled' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Badge> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|disabled|onClick|icon|fullWidth|className|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, disabled, onClick, icon, fullWidth, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:gold|dark|outline|ghost)$/]",
        "message": "<Button> variant must be one of 'gold' | 'dark' | 'outline' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LogEntry'] > JSXAttribute > JSXIdentifier[name!=/^(?:time|level|message|source|className|key|ref|className|style|children)$/]",
        "message": "<LogEntry> doesn't accept that prop. Declared props: time, level, message, source, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='LogEntry'] > JSXAttribute[name.name='level'] > Literal[value!=/^(?:ERR|WRN|INF|DBG|TRC)$/]",
        "message": "<LogEntry> level must be one of 'ERR' | 'WRN' | 'INF' | 'DBG' | 'TRC'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|padding|radius|bordered|glow|className|style|key|ref|className|style|children)$/]",
        "message": "<Panel> doesn't accept that prop. Declared props: children, variant, padding, radius, bordered, glow, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:raised|surface|overlay|glass)$/]",
        "message": "<Panel> variant must be one of 'raised' | 'surface' | 'overlay' | 'glass'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute[name.name='padding'] > Literal[value!=/^(?:none|sm|md|lg)$/]",
        "message": "<Panel> padding must be one of 'none' | 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute[name.name='radius'] > Literal[value!=/^(?:sm|md|lg|xl)$/]",
        "message": "<Panel> radius must be one of 'sm' | 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute[name.name='glow'] > Literal[value!=/^(?:gold|blue|pink|green|none)$/]",
        "message": "<Panel> glow must be one of 'gold' | 'blue' | 'pink' | 'green' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PlayerBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|teamColor|score|isUser|position|className|key|ref|className|style|children)$/]",
        "message": "<PlayerBadge> doesn't accept that prop. Declared props: name, teamColor, score, isUser, position, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='PlayerBadge'] > JSXAttribute[name.name='teamColor'] > Literal[value!=/^(?:gold|blue|red|green|pink)$/]",
        "message": "<PlayerBadge> teamColor must be one of 'gold' | 'blue' | 'red' | 'green' | 'pink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PlayerBadge'] > JSXAttribute[name.name='position'] > Literal[value!=/^(?:top|left|right|bottom)$/]",
        "message": "<PlayerBadge> position must be one of 'top' | 'left' | 'right' | 'bottom'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|placeholder|size|className|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: options, value, onChange, placeholder, size, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Select> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SpeedControl'] > JSXAttribute > JSXIdentifier[name!=/^(?:speeds|activeSpeed|isPlaying|onSpeedChange|onTogglePlay|onStep|className|key|ref|className|style|children)$/]",
        "message": "<SpeedControl> doesn't accept that prop. Declared props: speeds, activeSpeed, isPlaying, onSpeedChange, onTogglePlay, onStep, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='SuitSelector'] > JSXAttribute > JSXIdentifier[name!=/^(?:selected|onSelect|disabled|className|key|ref|className|style|children)$/]",
        "message": "<SuitSelector> doesn't accept that prop. Declared props: selected, onSelect, disabled, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='SuitSelector'] > JSXAttribute[name.name='selected'] > Literal[value!=/^(?:spades|hearts|diamonds|clubs)$/]",
        "message": "<SuitSelector> selected must be one of 'spades' | 'hearts' | 'diamonds' | 'clubs'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tabs'] > JSXAttribute > JSXIdentifier[name!=/^(?:tabs|activeId|onChange|className|key|ref|className|style|children)$/]",
        "message": "<Tabs> doesn't accept that prop. Declared props: tabs, activeId, onChange, className."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
